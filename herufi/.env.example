# Supabase — get these from your Supabase project dashboard (supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin email — this email gets admin access automatically
NEXT_PUBLIC_ADMIN_EMAIL=hello@herufi.org

# Site URL — used for auth redirects
NEXT_PUBLIC_SITE_URL=https://herufi.org

# Resend — get this from resend.com (herufi.org domain must be verified there
# so the contact form can send from hello@herufi.org)
RESEND_API_KEY=re_your-api-key-here

# =============================================================================
# Email platform (Listmonk campaigns, consent, Google Sheets contacts)
# Placeholders only. Never commit real values. Set these in Vercel (Production
# and Preview) and in .env.local for development. See docs/email-platform/.
# =============================================================================

# ---- Application ------------------------------------------------------------
# development | staging | production. Live sending is refused unless production.
APP_ENV=development
# Public address of this site, used in confirmation and unsubscribe links.
APP_BASE_URL=http://localhost:3000
# Comma separated administrator emails (falls back to NEXT_PUBLIC_ADMIN_EMAIL).
ADMIN_EMAILS=hello@herufi.org

# ---- Safe sending -----------------------------------------------------------
# disabled  : nothing is emailed and no contacts are pushed to Listmonk (default)
# allowlist : only EMAIL_TEST_ALLOWLIST addresses can receive email
# live      : normal operation, allowed only when APP_ENV=production
EMAIL_SEND_MODE=disabled
# Full addresses or @domain entries, comma separated.
EMAIL_TEST_ALLOWLIST=you@herufi.org
# Require a test email before a campaign can be sent (true by default).
EMAIL_REQUIRE_TEST_SEND=true

# ---- Application database (Supabase Postgres, direct or pooler connection) ----
# Server side only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgres://user:password@host:6543/postgres
# auto | require | disable. Set DATABASE_SSL_CA to a CA certificate to verify the server.
DATABASE_SSL=auto
# DATABASE_SSL_CA=

# ---- Secrets generated by you (use: openssl rand -hex 32) --------------------
# Signs unsubscribe links. Must be at least 32 characters. Changing it breaks old links.
EMAIL_TOKEN_SECRET=replace-with-64-random-hex-characters
# Protects the scheduled job endpoint. Also set CRON_SECRET to the same value on Vercel.
INTERNAL_JOB_SECRET=replace-with-64-random-hex-characters
# Signs delivery event webhooks (only if you post provider events to /api/webhooks/email-events).
EMAIL_WEBHOOK_SECRET=replace-with-64-random-hex-characters

# ---- Listmonk ---------------------------------------------------------------
LISTMONK_BASE_URL=https://listmonk.example.com
LISTMONK_API_USERNAME=herufi_api
LISTMONK_API_TOKEN=replace-with-the-listmonk-api-token
# Optional. If your proxy only lets requests with this header reach /api, set it here.
LISTMONK_PROXY_TOKEN=

# ---- Google Sheets (read only service account) --------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=herufi-sheets@your-project.iam.gserviceaccount.com
# The private key from the service account JSON, with newlines written as \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace\n-----END PRIVATE KEY-----\n"
# Optional defaults for the import screen.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=

# ---- Sender defaults (used when no sender identity exists yet) ----------------
DEFAULT_FROM_NAME=Herufi
DEFAULT_FROM_EMAIL=hello@herufi.org
DEFAULT_REPLY_TO_EMAIL=hello@herufi.org

# ---- Email delivery SMTP ------------------------------------------------------
# These are entered in Listmonk under Settings, SMTP. Herufi itself never reads
# them. They are listed here so the values live in one documented place.
# Resend example: host smtp.resend.com, port 465 (TLS) or 587 (STARTTLS),
# username "resend", password = a Resend API key. Amazon SES works the same way.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=
